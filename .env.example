# OZ Commercial Solar Lead Pipeline — required/optional environment variables.
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# Names only here — no secrets. See docs/commercial_api_and_data_requirements.md.

# ── EPC (non-domestic) — official gov EPC API. REQUIRED for commercial EPC/MEES.
# Get from https://epc.opendatacommunities.org/  (email + API key → Basic/Bearer token)
EPC_BEARER_TOKEN=
EPC_API=https://epc.opendatacommunities.org/api/v1

# ── Companies House — business identity/SIC/status. OPTIONAL (degrades to sector-level).
# Get from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ── PVGIS irradiance — generation modelling. OPTIONAL (built-in fallback irradiance used).
# No key required for the public JRC PVGIS endpoint.
PVGIS_API=https://re.jrc.ec.europa.eu/api/v5_2

# ── planning.data.gov.uk — conservation areas / listed buildings. OPTIONAL (no key needed).
PLANNING_DATA_API=https://www.planning.data.gov.uk

# ── postcodes.io — postcode ↔ LSOA/lat-lon. OPTIONAL (local ONSPD used as primary).
POSTCODES_API=https://api.postcodes.io

# ── OS Data Hub (NGD/Features) — authoritative footprints. OPTIONAL (local MasterMap DuckDB used).
OS_DATA_HUB_API_KEY=
OS_DATA_HUB_API_SECRET=

# ── Local data file paths (override defaults under data/). OPTIONAL.
OS_OPEN_UPRN_CSV=data/os_uprn/oxford_uprn.csv
MCS_INSTALLERS_CSV=data/mcs/oxford_mcs_installers.csv
ONSPD_PATH=data/onspd/onspd_oxford.parquet
OS_MASTERMAP_BUILDINGS_DB=data/db/buildings_oxford.duckdb

# ── Telegram (OpenClaw routing) — OPTIONAL, used only for run notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
